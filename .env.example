# =====================================================================
# FXT Support Helper - Environment Configuration (.env)
# =====================================================================

# AI Articulation Provider: 'openai' (Recommended) or 'builtin' or 'ollama'
AI_PROVIDER=openai

# OpenAI API Key (Obtain from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# Preferred OpenAI Model: 'gpt-4o-mini' (Fast & Cost-Effective) or 'gpt-4o'
OPENAI_MODEL=gpt-4o-mini

# OpenAI API Endpoint (Standard or custom corporate Azure/proxy endpoint)
OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama endpoint (Optional if using local LLM)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
